{
  "name": "reading-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_USE_ENV_PROXY=1 tsx server/index.ts",
    "worker": "NODE_USE_ENV_PROXY=1 tsx server/worker.ts",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_USE_ENV_PROXY=1 NODE_ENV=production tsx server/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "playwright test",
    "seed": "tsx server/seed.ts",
    "admin": "tsx scripts/admin.ts"
  },
  "dependencies": {
    "express": "^5.1.0",
    "luxon": "^3.7.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/express": "^5.0.0",
    "@types/luxon": "^3.7.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "3.6.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  }
}
